JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Development scripts only. Set temporarily, never commit actual values.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
SEED_PASSWORD=
