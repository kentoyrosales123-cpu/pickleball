NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Atlas or a local replica set; standalone MongoDB does not support transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/pickleball?replicaSet=rs0
